{
	"name": "Themes of Shibbir: Dark Shades",
	"type": "dark",
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": "#C9B285",
		"class": "#C9B285",
		"interface": "#C9B285",
		"enum": "#C9B285",
		"struct": "#C9B285",
		"type": "#C9B285",
		"typeParameter": "#C9B285",
		"function": "#7BA7CC",
		"method": "#7BA7CC",
		"event": "#7BA7CC",
		"decorator": "#7BA7CC",
		"macro": "#A98CC8",
		"parameter": "#C39B72",
		"enumMember": "#C39B72",
		"variable": "#C08A8F",
		"property": "#C3CBD5",
		"*.readonly": "#C39B72",
		"*.deprecated": {
			"strikethrough": true
		}
	},
	"colors": {
		"editor.background": "#1B222A",
		"editor.foreground": "#C3CBD5",
		"sideBar.background": "#161C22"
	},
	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#556070"
			}
		}
	]
}
