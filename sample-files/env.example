# Dotenv sample. Named env.example so it is not caught by the .env gitignore rule.
# All values here are placeholders and are not real credentials.

APP_NAME="Themes of Shibbir"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=base64:PLACEHOLDER_NOT_A_REAL_KEY_00000000000000=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=themes
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

VSCE_OUT_DIR=./dist
VSCE_TARGET=vs-dark
NODE_ENV=development

# Inline comment after a value is a common source of parsing bugs.
TIMEOUT_SECONDS=120 # seconds
EMPTY_VALUE=
QUOTED_WITH_SPACES="value with spaces"
INTERPOLATED=${APP_URL}/api
MULTIWORD_UNQUOTED=this is technically valid
