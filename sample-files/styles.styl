// Stylus sample. The theme targets `source.stylus support.type.property-name`,
// so property names should match the other CSS dialects at #B2CCD6.

@import 'variables'

background = #263238
foreground = #eeffff
accent = #82aaff
spacing = 8px

breakpoints = {
  small: 480px,
  medium: 768px,
  large: 1200px
}

rounded(radius = 4px)
  border-radius radius
  overflow hidden

card-base()
  box-shadow 0 2px 6px rgba(0, 0, 0, 0.35)
  background-color darken(background, 3%)

respond-to(name)
  value = breakpoints[name]
  if value
    @media (min-width: value)
      {block}

.palette
  card-base()
  rounded(6px)

  display grid
  grid-template-columns repeat(auto-fill, minmax(180px, 1fr))
  gap spacing * 2
  padding spacing * 3
  background-color background
  color foreground

  &__title
    font-size 20px
    font-weight 600

  &__swatch
    aspect-ratio 1 / 1
    background-color accent
    cursor pointer
    transition transform 150ms ease-in-out

    &:hover
    &:focus-visible
      transform scale(1.02)
      outline 2px solid accent

    &.is-active::after
      content '\2713'
      position absolute

for name, hex in { keyword: #c792ea, string: #c3e88d, number: #f78c6c }
  .token--{name}
    color hex

for i in 1..4
  .mt-{i}
    margin-top spacing * i

@keyframes fade-in
  from
    opacity 0
  to
    opacity 1
