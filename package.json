{
  "name": "themes-of-shibbir",
  "displayName": "Themes of Shibbir",
  "description": "Themes of Md. Shibbir Ahmed",
  "version": "0.1.0",
  "publisher": "shibbirweb",
  "icon": "icon.png",
  "packageManager": "pnpm@11.9.0",
  "license": "MIT",
  "author": {
    "name": "Md. Shibbir Ahmed",
    "email": "shibbirweb@gmail.com",
    "url": "https://shibbirweb.github.io"
  },
  "sponsor": {
    "url": "https://buymeacoffee.com/shibbirweb"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shibbirweb/themes-of-shibbir"
  },
  "bugs": {
    "url": "https://github.com/shibbirweb/themes-of-shibbir/issues"
  },
  "engines": {
    "vscode": "^1.12.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "dark-theme",
    "light",
    "light-theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Themes of Shibbir: Islands Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/islands-dark-color-theme.json"
      },
      {
        "label": "Themes of Shibbir: Islands Light",
        "uiTheme": "vs",
        "path": "./themes/islands-light-color-theme.json"
      }
    ]
  },
  "scripts": {
    "validate": "node scripts/validate-themes.mjs && node scripts/version.mjs check",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.0.2"
  }
}
